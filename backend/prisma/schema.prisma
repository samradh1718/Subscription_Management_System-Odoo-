generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------
enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum ProductType {
  SERVICE
  GOODS
  ADD_ON
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum DiscountType {
  FIXED
  PERCENT
}

enum DiscountScope {
  PRODUCT
  SUBSCRIPTION
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  UPI
  CHEQUE
}

// ---------- IDENTITY ----------
model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  customer          Customer?
  resetTokens       PasswordResetToken[]
  subscriptions     Subscription[]              @relation("SubCreatedBy")
  statusChanges     SubscriptionStatusHistory[]
  paymentsRecorded  Payment[]
  discountsCreated  Discount[]
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
}

model Customer {
  id             Int     @id @default(autoincrement())
  userId         Int?    @unique
  name           String
  email          String
  phone          String?
  company        String?
  billingAddress String?

  user          User?          @relation(fields: [userId], references: [id])
  subscriptions Subscription[]
  invoices      Invoice[]
}

// ---------- CATALOG ----------
model Tax {
  id          Int     @id @default(autoincrement())
  name        String
  ratePercent Float
  isActive    Boolean @default(true)
  products    Product[]
}

model Product {
  id         Int         @id @default(autoincrement())
  name       String
  type       ProductType @default(SERVICE)
  salesPrice Int
  costPrice  Int         @default(0)
  notes      String?
  taxId      Int?
  isActive   Boolean     @default(true)

  tax               Tax?                    @relation(fields: [taxId], references: [id])
  variants          ProductVariant[]
  templateLines     QuotationTemplateLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines      InvoiceLine[]
  discountProducts  DiscountProduct[]
}

model ProductVariant {
  id         Int    @id @default(autoincrement())
  productId  Int
  attribute  String
  value      String
  extraPrice Int    @default(0)

  product           Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  templateLines     QuotationTemplateLine[]
  subscriptionLines SubscriptionLine[]
}

model Plan {
  id            Int           @id @default(autoincrement())
  name          String
  price         Int
  billingPeriod BillingPeriod
  minQuantity   Int           @default(1)
  availableFrom DateTime?
  availableTo   DateTime?
  autoClose     Boolean       @default(false)
  canClose      Boolean       @default(true)
  canPause      Boolean       @default(true)
  canRenew      Boolean       @default(true)
  isActive      Boolean       @default(true)

  templates     QuotationTemplate[]
  subscriptions Subscription[]
}

// ---------- QUOTATIONS ----------
model QuotationTemplate {
  id           Int     @id @default(autoincrement())
  name         String
  planId       Int
  validityDays Int     @default(30)
  notes        String?

  plan  Plan                    @relation(fields: [planId], references: [id])
  lines QuotationTemplateLine[]
}

model QuotationTemplateLine {
  id         Int  @id @default(autoincrement())
  templateId Int
  productId  Int
  variantId  Int?
  quantity   Int  @default(1)

  template QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id])
  variant  ProductVariant?   @relation(fields: [variantId], references: [id])
}

// ---------- SUBSCRIPTIONS ----------
model Subscription {
  id               Int                @id @default(autoincrement())
  number           String?            @unique
  customerId       Int
  planId           Int
  status           SubscriptionStatus @default(DRAFT)
  startDate        DateTime
  expiryDate       DateTime
  nextBillingDate  DateTime?
  paymentTermsDays Int                @default(15)
  quoteValidUntil  DateTime?
  subtotal         Int                @default(0)
  discountTotal    Int                @default(0)
  taxTotal         Int                @default(0)
  total            Int                @default(0)
  createdById      Int?
  createdAt        DateTime           @default(now())

  customer  Customer @relation(fields: [customerId], references: [id])
  plan      Plan     @relation(fields: [planId], references: [id])
  createdBy User?    @relation("SubCreatedBy", fields: [createdById], references: [id])

  lines     SubscriptionLine[]
  history   SubscriptionStatusHistory[]
  invoices  Invoice[]
  discounts SubscriptionDiscount[]

  @@index([status, nextBillingDate])
  @@index([customerId])
}

model SubscriptionLine {
  id             Int   @id @default(autoincrement())
  subscriptionId Int
  productId      Int
  variantId      Int?
  quantity       Int
  unitPrice      Int
  taxRate        Float @default(0)
  amount         Int

  subscription Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id])
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
}

model SubscriptionStatusHistory {
  id             Int                 @id @default(autoincrement())
  subscriptionId Int
  fromStatus     SubscriptionStatus?
  toStatus       SubscriptionStatus
  changedById    Int?
  changedAt      DateTime            @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  changedBy    User?        @relation(fields: [changedById], references: [id])

  @@index([subscriptionId])
}

// ---------- INVOICES ----------
model Invoice {
  id             Int           @id @default(autoincrement())
  number         String?       @unique
  subscriptionId Int
  customerId     Int
  status         InvoiceStatus @default(DRAFT)
  invoiceDate    DateTime
  dueDate        DateTime
  periodStart    DateTime
  periodEnd      DateTime
  subtotal       Int           @default(0)
  discountTotal  Int           @default(0)
  taxTotal       Int           @default(0)
  total          Int           @default(0)
  amountPaid     Int           @default(0)
  amountDue      Int           @default(0)
  sentAt         DateTime?
  createdAt      DateTime      @default(now())

  subscription Subscription  @relation(fields: [subscriptionId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])
  lines        InvoiceLine[]
  payments     Payment[]
  usages       DiscountUsage[]

  @@unique([subscriptionId, periodStart])
  @@index([status, dueDate])
  @@index([customerId])
  @@index([subscriptionId])
}

model InvoiceLine {
  id             Int     @id @default(autoincrement())
  invoiceId      Int
  productId      Int?
  description    String
  quantity       Int
  unitPrice      Int
  discountAmount Int     @default(0)
  taxRate        Float   @default(0)
  taxAmount      Int     @default(0)
  lineTotal      Int

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
}

// ---------- DISCOUNTS ----------
model Discount {
  id          Int           @id @default(autoincrement())
  name        String
  type        DiscountType
  value       Int
  minPurchase Int?
  minQuantity Int?
  startDate   DateTime
  endDate     DateTime
  usageLimit  Int?
  usedCount   Int           @default(0)
  scope       DiscountScope
  isActive    Boolean       @default(true)
  createdById Int?

  createdBy     User?                  @relation(fields: [createdById], references: [id])
  products      DiscountProduct[]
  subscriptions SubscriptionDiscount[]
  usages        DiscountUsage[]
}

model DiscountProduct {
  discountId Int
  productId  Int
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
}

model SubscriptionDiscount {
  subscriptionId Int
  discountId     Int
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  discount       Discount     @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@id([subscriptionId, discountId])
}

model DiscountUsage {
  id         Int      @id @default(autoincrement())
  discountId Int
  invoiceId  Int
  amount     Int
  discount   Discount @relation(fields: [discountId], references: [id])
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([discountId])
}

// ---------- PAYMENTS ----------
model Payment {
  id           Int           @id @default(autoincrement())
  invoiceId    Int
  amount       Int
  method       PaymentMethod
  paymentDate  DateTime
  note         String?
  recordedById Int?

  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  recordedBy User?   @relation(fields: [recordedById], references: [id])

  @@index([invoiceId])
  @@index([paymentDate])
}
